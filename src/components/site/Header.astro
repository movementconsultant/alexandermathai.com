---
import { primaryNav, primaryCta } from "../../data/nav";
import { site } from "../../data/site";
import ThemeToggle from "../ui/ThemeToggle.astro";

const currentPath = Astro.url.pathname;

function isActive(href: string) {
  if (href === "/") return currentPath === "/";
  return currentPath === href || currentPath.startsWith(`${href}/`);
}
---

<div class="context-line">
  <div class="wrap context-line__inner">
    <p>Founder &amp; President, Texas Movement International</p>
  </div>
</div>

<header class="site-header">
  <div class="wrap site-header__inner">
    <a href="/" class="brand-mark">
      {site.name}
    </a>

    <nav class="site-nav" aria-label="Primary">
      <ul>
        {
          primaryNav.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <a href={primaryCta.href} class="btn btn--primary btn--compact">{primaryCta.label}</a>
      <ThemeToggle />
      <button
        type="button"
        id="menu-open"
        class="menu-button"
        aria-haspopup="dialog"
        aria-controls="mobile-menu"
      >
        <span class="visually-hidden">Open menu</span>
        <span aria-hidden="true" class="menu-button__icon">
          <span></span><span></span><span></span>
        </span>
      </button>
    </div>
  </div>
</header>

<dialog id="mobile-menu" class="mobile-menu" aria-label="Site navigation">
  <div class="mobile-menu__header">
    <p class="brand-mark">{site.name}</p>
    <button type="button" id="menu-close" class="menu-button">
      <span class="visually-hidden">Close menu</span>
      <span aria-hidden="true">&times;</span>
    </button>
  </div>
  <nav aria-label="Mobile primary">
    <ul class="mobile-menu__list">
      {
        primaryNav.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <a href={primaryCta.href} class="btn btn--primary">{primaryCta.label}</a>
</dialog>

<style>
  .context-line {
    border-bottom: var(--border-hairline);
    background: var(--color-bg);
  }

  .context-line__inner {
    padding-block: 0.45rem;
  }

  .context-line p {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--color-bg);
    border-bottom: var(--border-hairline);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block: var(--space-2);
  }

  .brand-mark {
    font-family: var(--font-display);
    font-size: 1.15rem;
    text-decoration: none;
    color: var(--color-text);
    white-space: nowrap;
  }

  .site-nav ul {
    display: flex;
    gap: var(--space-3);
  }

  .site-nav a {
    text-decoration: none;
    color: var(--color-text-muted);
    font-size: 0.92rem;
    font-weight: 500;
    padding-block: 0.25rem;
    border-bottom: 2px solid transparent;
  }

  .site-nav a:hover,
  .site-nav a[aria-current="page"] {
    color: var(--color-text);
    border-bottom-color: var(--color-text);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .btn--compact {
    padding: 0.6em 1.1em;
    min-height: 40px;
  }

  .menu-button {
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    color: var(--color-text);
  }

  .menu-button__icon {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .menu-button__icon span {
    display: block;
    width: 18px;
    height: 2px;
    background: currentColor;
  }

  @media (max-width: 56rem) {
    .site-nav {
      display: none;
    }

    .site-header__actions .btn--primary {
      display: none;
    }

    .menu-button {
      display: inline-flex;
    }
  }

  .mobile-menu {
    border: none;
    padding: 0;
    inset: 0;
    max-width: min(24rem, 100vw);
    height: 100vh;
    max-height: 100vh;
    margin: 0 0 0 auto;
    background: var(--color-bg);
    color: var(--color-text);
  }

  .mobile-menu::backdrop {
    background: rgb(0 0 0 / 0.55);
  }

  .mobile-menu[open] {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-3);
  }

  .mobile-menu__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .mobile-menu__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .mobile-menu__list a {
    display: block;
    min-height: 44px;
    padding-block: 0.4rem;
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 1.35rem;
    color: var(--color-text);
  }

  .mobile-menu__list a[aria-current="page"] {
    color: var(--color-text);
  }
</style>

<script>
  const dialogEl = document.getElementById("mobile-menu") as HTMLDialogElement | null;
  const openBtn = document.getElementById("menu-open");
  const closeBtn = document.getElementById("menu-close");

  openBtn?.addEventListener("click", () => {
    dialogEl?.showModal();
  });

  closeBtn?.addEventListener("click", () => {
    dialogEl?.close();
  });

  dialogEl?.addEventListener("click", (event) => {
    if (event.target === dialogEl) dialogEl.close();
  });

  dialogEl?.addEventListener("close", () => {
    openBtn?.focus();
  });

  dialogEl?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => dialogEl.close());
  });
</script>
