---
import type { CollectionEntry } from "astro:content";
import { formatDate } from "../../utils/reading-time";

interface Props {
  entry: CollectionEntry<"notes">;
}

const { entry } = Astro.props;
const { data } = entry;

const typeLabel: Record<string, string> = {
  "field-note": "Field Note",
  "build-log": "Build Log",
  "system-brief": "System Brief",
  essay: "Essay",
  "media-note": "Media Note",
};
---

<article class="card note-card">
  <p class="label-mono">{typeLabel[data.type]} &middot; {formatDate(data.publishDate)}</p>
  <h3><a href={`/notes/${entry.id}`}>{data.title}</a></h3>
  <p class="note-card__description">{data.description}</p>
  {
    data.tags.length > 0 && (
      <ul class="cluster note-card__tags">
        {data.tags.map((tag) => (
          <li class="label-mono">{tag}</li>
        ))}
      </ul>
    )
  }
</article>

<style>
  .note-card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .note-card h3 {
    font-size: 1.1rem;
  }

  .note-card h3 a {
    text-decoration: none;
  }

  .note-card h3 a:hover {
    color: var(--color-text-muted);
  }

  .note-card__description {
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }

  .note-card__tags li {
    border: 1px solid var(--color-border-strong);
    padding: 0.2em 0.7em;
  }
</style>
