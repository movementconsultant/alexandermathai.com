---
import { proofMetrics, proofDisclaimer } from "../../data/proof";
---

<section class="section section--tight proof-rail" aria-label="Founder proof">
  <div class="wrap">
    <ul class="proof-rail__grid">
      {
        proofMetrics.map((metric) => (
          <li class="proof-rail__item">
            <p class="proof-rail__value">{metric.value}</p>
            <p class="proof-rail__label">{metric.label}</p>
            <p class="proof-rail__context">{metric.context}</p>
          </li>
        ))
      }
    </ul>
    <p class="label-mono proof-rail__disclaimer">{proofDisclaimer}</p>
  </div>
</section>

<style>
  .proof-rail__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: var(--space-4);
    border-top: var(--border-hairline);
    padding-block-start: var(--space-4);
  }

  .proof-rail__value {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 1.4rem + 1.4vw, 2.6rem);
    color: var(--color-text);
  }

  .proof-rail__label {
    font-weight: 600;
    margin-block-start: 0.35rem;
  }

  .proof-rail__context {
    color: var(--color-text-muted);
    font-size: 0.88rem;
    margin-block-start: 0.35rem;
  }

  .proof-rail__disclaimer {
    margin-block-start: var(--space-3);
  }
</style>
