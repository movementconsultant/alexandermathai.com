---
import EcosystemMap from "../ecosystem/EcosystemMap.astro";
---

<section class="section ecosystem-preview">
  <div class="wrap">
    <h2>Texas Movement International</h2>
    <p class="lede">
      One founder, one umbrella organization, and a set of divisions at different stages of maturity
      — from an active consulting practice to early-stage exploration.
    </p>
    <EcosystemMap />
    <a href="/ecosystem" class="btn btn--secondary ecosystem-preview__cta"
      >Explore the TMI ecosystem</a
    >
  </div>
</section>

<style>
  .ecosystem-preview__cta {
    margin-block-start: var(--space-4);
  }
</style>
