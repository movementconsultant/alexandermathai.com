---
import { getCollection } from "astro:content";
import NoteCard from "../content/NoteCard.astro";

const notes = (await getCollection("notes", ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);
---

<section class="section field-notes">
  <div class="wrap">
    <div class="field-notes__heading">
      <h2>Field notes</h2>
      <a href="/notes" class="text-link">Read all notes &rarr;</a>
    </div>
    <ul class="field-notes__grid">
      {
        notes.map((entry) => (
          <li>
            <NoteCard entry={entry} />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .field-notes__heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-block-end: var(--space-4);
  }

  .field-notes__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-3);
  }
</style>
