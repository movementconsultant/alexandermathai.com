---
import { getCollection } from "astro:content";
import SystemBriefCard from "../work/SystemBriefCard.astro";

const entries = (await getCollection("work", ({ data }) => !data.draft && data.featured)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);
---

<section class="section selected-work">
  <div class="wrap">
    <div class="selected-work__heading">
      <h2>Selected work</h2>
      <a href="/work" class="text-link">See all work &rarr;</a>
    </div>
    <ul class="selected-work__grid">
      {
        entries.map((entry) => (
          <li>
            <SystemBriefCard entry={entry} />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .selected-work__heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-block-end: var(--space-4);
  }

  .selected-work__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: var(--space-3);
  }
</style>
