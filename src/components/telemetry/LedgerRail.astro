---
/**
 * The Ledger rail. Renders up to 3 recent Substack article references
 * (title, date, static link) or a static fallback link to the publication
 * itself when the build-time fetch/parse fails or returns nothing safe to
 * show. Never a title, excerpt, or any field beyond what
 * docs/mark-13-telemetry-rails-implementation.md's guardrail table allows.
 */
import { getLedgerItems } from "../../lib/ledger";
import TelemetryDisclosure from "./TelemetryDisclosure.astro";

const result = await getLedgerItems();
const PUBLICATION_URL = "https://texasmovement.substack.com";
---

<div class="ledger-rail">
  {
    result.status === "ok" ? (
      <>
        <p class="ledger-live">
          <span class="ledger-live-dot" aria-hidden="true"></span>
          Live telemetry
        </p>
        <ul class="ledger-list">
          {result.items.map((item) => (
            <li>
              <a
                href={item.link}
                target="_blank"
                rel="noopener noreferrer"
                class="ledger-item-link"
              >
                {item.title}
              </a>
              {item.publishedAt && (
                <time class="ledger-item-date" datetime={item.publishedAt}>
                  {new Date(item.publishedAt).toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "short",
                    day: "numeric",
                  })}
                </time>
              )}
            </li>
          ))}
        </ul>
        <TelemetryDisclosure sourceLabel="Substack" />
      </>
    ) : (
      <div class="ledger-fallback">
        <p class="signal-lost-line">
          <span aria-hidden="true">&gt;</span> SIGNAL LOST // AWAITING RECONNECTION // ROUTING TO
          SOURCE
        </p>
        <p class="signal-lost-description">
          The Signal Archive's automated index isn't available for this build. Read the newsletter
          directly:
        </p>
        <a href={PUBLICATION_URL} target="_blank" rel="noopener noreferrer" class="text-link">
          Texas Movement on Substack &rarr;
        </a>
      </div>
    )
  }
</div>

<style>
  .ledger-live {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-block-end: var(--space-2);
  }

  .ledger-live-dot {
    width: 7px;
    height: 7px;
    background: var(--color-positive);
    flex-shrink: 0;
  }

  .ledger-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .ledger-list li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2);
    padding-block: var(--space-2);
    border-block-end: 1px solid var(--color-border-strong);
  }

  .ledger-item-link {
    font-weight: 600;
  }

  .ledger-item-date {
    font-size: 0.85rem;
    color: var(--color-text-faint);
    white-space: nowrap;
  }

  /* Mark 25 — "Signal Lost" terminal state. When the build-time fetch
     fails, this should read as an intentional, gracefully-handled system
     state, not a broken page. Signal Green here is a direct extension of
     the same "live telemetry indicator" allowance already used for the
     OK-state dot above — this IS that indicator's degraded state. */
  .ledger-fallback {
    padding: var(--space-3);
    border: 1px solid var(--color-border-strong);
    background: var(--color-bg-raised);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .signal-lost-line {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.03em;
    color: var(--color-accent);
  }

  .signal-lost-description {
    font-size: 0.88rem;
    color: var(--color-text-muted);
  }
</style>
