---
import { getCollection, getEntry, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TableOfContents from "../../components/content/TableOfContents.astro";
import NoteCard from "../../components/content/NoteCard.astro";
import Button from "../../components/ui/Button.astro";
import { formatDate, readingTime } from "../../utils/reading-time";

export async function getStaticPaths() {
  const entries = await getCollection("notes", ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"notes">;
}

const { entry } = Astro.props;
const { data, body } = entry;
const { Content, headings } = await render(entry);

const typeLabel: Record<string, string> = {
  "field-note": "Field Note",
  "build-log": "Build Log",
  "system-brief": "System Brief",
  essay: "Essay",
  "media-note": "Media Note",
};

const allNotes = await getCollection("notes", ({ data: d }) => !d.draft);
const related = allNotes
  .filter((n) => n.id !== entry.id && n.data.tags.some((t) => data.tags.includes(t)))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 2);

const relatedWork = data.relatedWorkSlug ? await getEntry("work", data.relatedWorkSlug) : undefined;

const articleLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: data.title,
  description: data.description,
  datePublished: data.publishDate.toISOString(),
  dateModified: (data.updatedDate ?? data.publishDate).toISOString(),
  author: { "@type": "Person", name: "Alexander Mathai" },
};

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://alexandermathai.com/" },
    { "@type": "ListItem", position: 2, name: "Notes", item: "https://alexandermathai.com/notes" },
    {
      "@type": "ListItem",
      position: 3,
      name: data.title,
      item: `https://alexandermathai.com/notes/${entry.id}`,
    },
  ],
};
---

<BaseLayout
  title={`${data.title} — Alexander Mathai`}
  description={data.description}
  structuredData={[articleLd, breadcrumbLd]}
>
  <article class="section section--tight">
    <div class="wrap prose note-detail__header">
      <p class="eyebrow">{typeLabel[data.type]}</p>
      <h1>{data.title}</h1>
      <p class="lede">{data.description}</p>
      <p class="label-mono">
        {formatDate(data.publishDate)}
        {data.updatedDate && ` · Updated ${formatDate(data.updatedDate)}`}
        {" · "}{readingTime(body ?? "")}
      </p>
      {
        data.tags.length > 0 && (
          <ul class="cluster note-detail__tags">
            {data.tags.map((tag) => (
              <li class="label-mono">{tag}</li>
            ))}
          </ul>
        )
      }
    </div>
  </article>

  <section class="section">
    <div class="wrap note-detail__grid">
      <div class="prose note-detail__body">
        <Content />
      </div>
      <aside class="note-detail__aside">
        <TableOfContents headings={headings} />
        {
          relatedWork && (
            <div class="card">
              <p class="label-mono">Related work</p>
              <a href={`/work/${relatedWork.id}`} class="text-link">
                {relatedWork.data.title} &rarr;
              </a>
            </div>
          )
        }
        {
          data.relatedEcosystemSlug && (
            <div class="card">
              <p class="label-mono">Related ecosystem division</p>
              <a href={`/ecosystem#${data.relatedEcosystemSlug}`} class="text-link">
                See on the ecosystem map &rarr;
              </a>
            </div>
          )
        }
        <div class="card">
          <p class="label-mono">Continue</p>
          <p><a href="/contact" class="text-link">Discuss a system &rarr;</a></p>
        </div>
      </aside>
    </div>
  </section>

  {
    related.length > 0 && (
      <section class="section section--tight">
        <div class="wrap">
          <h2>Related notes</h2>
          <ul class="note-detail__related">
            {related.map((n) => (
              <li>
                <NoteCard entry={n} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="section section--tight">
    <div class="wrap">
      <Button href="/notes" variant="secondary">&larr; Back to all notes</Button>
    </div>
  </section>
</BaseLayout>

<style>
  .note-detail__tags {
    margin-block-start: var(--space-2);
  }

  .note-detail__tags li {
    border: 1px solid var(--color-border-strong);
    padding: 0.2em 0.7em;
  }

  .note-detail__grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: var(--space-5);
    align-items: start;
  }

  @media (max-width: 56rem) {
    .note-detail__grid {
      grid-template-columns: 1fr;
    }
  }

  .note-detail__body :global(h2) {
    margin-block: var(--space-4) var(--space-2);
    font-size: 1.35rem;
  }

  .note-detail__body :global(p) {
    color: var(--color-text-muted);
  }

  .note-detail__body :global(p + p) {
    margin-block-start: var(--space-2);
  }

  .note-detail__body :global(ul),
  .note-detail__body :global(ol) {
    margin-block: var(--space-2);
    padding-inline-start: 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    color: var(--color-text-muted);
  }

  .note-detail__body :global(li) {
    list-style: disc;
  }

  .note-detail__aside {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    position: sticky;
    top: 6rem;
  }

  .note-detail__related {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-3);
    margin-block-start: var(--space-3);
  }
</style>
