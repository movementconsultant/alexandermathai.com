---
// src/pages/field.astro
//
// Mark 22 — "Field Log": a dense, timestamped operations log. Seeded with
// real, dated entries drawn from this repository's own commit history (see
// `git log`), not from any external platform — this session has no TikTok
// access and no way to verify unobserved social-media activity, so nothing
// here claims to mirror a specific external account's posting cadence.
// Framed honestly as this site's own build/engineering/governance log.
import BaseLayout from "../layouts/BaseLayout.astro";

interface FieldEntry {
  date: string; // ISO, for the <time> element
  label: string; // short display form
  note: string;
  tags: string[];
}

const entries: FieldEntry[] = [
  {
    date: "2026-08-18",
    label: "08-18",
    note: "Sovereign lexicon applied ecosystem-wide; secondary intake protocol added to /contact.",
    tags: ["copy", "contact"],
  },
  {
    date: "2026-08-18",
    label: "08-18",
    note: "Brutalist visual system (Void Black / Signal Green / 0px radius) applied across TMI and AVM.",
    tags: ["design"],
  },
  {
    date: "2026-08-17",
    label: "08-17",
    note: "Contact-intake Worker source and live contact-form wiring shipped (undeployed).",
    tags: ["engineering"],
  },
  {
    date: "2026-08-17",
    label: "08-17",
    note: "Signal Archive and Operational Commit Log telemetry rails added.",
    tags: ["telemetry"],
  },
  {
    date: "2026-08-17",
    label: "08-17",
    note: "Founder systems archive and AVM founder-layer review completed.",
    tags: ["governance"],
  },
];

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://alexandermathai.com/" },
    {
      "@type": "ListItem",
      position: 2,
      name: "Field Log",
      item: "https://alexandermathai.com/field",
    },
  ],
};
---

<BaseLayout
  title="Field Log — Alexander Mathai"
  description="A dense, timestamped log of this site's own build, design, and governance activity — hand-curated, not automatically retrieved."
  structuredData={[breadcrumbLd]}
>
  <section class="section section--tight">
    <div class="wrap prose">
      <p class="eyebrow">Field Log</p>
      <h1>Operations, timestamped.</h1>
      <p class="lede">
        A hand-curated, dated log of this site's own build, design, and governance activity —
        distinct from the automatically retrieved Signal Archive and Operational Commit Log.
        Entries below are drawn from this repository's real commit history, not from any external
        platform.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <ul class="field-log">
        {
          entries.map((entry) => (
            <li>
              <time class="field-log-date" datetime={entry.date}>
                {entry.label}
              </time>
              <span class="field-log-note">{entry.note}</span>
              {entry.tags.length > 0 && (
                <span class="field-log-tags">
                  {entry.tags.map((tag) => (
                    <span class="field-log-tag">{tag}</span>
                  ))}
                </span>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .field-log {
    list-style: none;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border-strong);
    font-family: var(--font-mono);
  }

  .field-log li {
    display: grid;
    grid-template-columns: 5rem 1fr auto;
    align-items: baseline;
    gap: var(--space-2);
    padding: 12px 16px;
    border-bottom: 1px solid var(--color-border);
  }

  .field-log li:last-child {
    border-bottom: none;
  }

  .field-log li:nth-child(even) {
    background: var(--color-bg-raised);
  }

  @media (max-width: 40rem) {
    .field-log li {
      grid-template-columns: 1fr;
      gap: 6px;
    }
  }

  .field-log-date {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .field-log-note {
    font-size: 0.9rem;
    color: var(--color-text);
    line-height: 1.5;
  }

  .field-log-tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  .field-log-tag {
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    border: 1px solid var(--color-border-strong);
    padding: 2px 6px;
    white-space: nowrap;
  }
</style>
