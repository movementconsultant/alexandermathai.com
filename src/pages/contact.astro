---
import BaseLayout from "../layouts/BaseLayout.astro";

// Mark 18 — env-var-gated live submission, per this file's own prior plan
// in docs/site-operations.md "Contact-form integration point". Unset in
// every build this repository runs today (resolves to an empty string at
// build time via Vite's import.meta.env inlining), which keeps this page
// exactly as inert as it was before this pass — no literal external fetch()
// target reaches dist/, so scripts/postbuild-guard.mjs's
// EXTERNAL_FETCH_PATTERN check stays green. See
// docs/mark-18-contact-intake-implementation.md and
// workers/contact-intake/README.md for the backend this would connect to.
const contactEndpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT ?? "";

const reasonOptions = [
  { value: "ai-systems", label: "AI systems / operations" },
  { value: "web-brand", label: "Web or brand architecture" },
  { value: "consulting", label: "Consulting engagement" },
  { value: "media", label: "Media or partnership" },
  { value: "hero-product", label: "HERO / product" },
  { value: "performance", label: "Performance-related inquiry" },
  { value: "other", label: "Other" },
];

const timelineOptions = [
  { value: "", label: "Select one" },
  { value: "now", label: "Ready to start now" },
  { value: "1-3-months", label: "1–3 months out" },
  { value: "exploring", label: "Exploring, no set timeline" },
];

const budgetOptions = [
  { value: "", label: "Prefer not to say" },
  { value: "under-10k", label: "Under $10k" },
  { value: "10k-50k", label: "$10k–$50k" },
  { value: "50k-plus", label: "$50k+" },
  { value: "not-sure", label: "Not sure yet — that's part of the conversation" },
];

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://alexandermathai.com/" },
    {
      "@type": "ListItem",
      position: 2,
      name: "Contact",
      item: "https://alexandermathai.com/contact",
    },
  ],
};
---

<BaseLayout
  title="Contact — Alexander Mathai"
  description="Start a conversation about a consulting engagement, strategic partnership, media inquiry, or institutional collaboration."
  structuredData={[breadcrumbLd]}
>
  <section class="section section--tight">
    <div class="wrap prose">
      <p class="eyebrow">Contact</p>
      <h1>Start with the system, not the pitch.</h1>
      <p class="lede">
        Use this form for consulting inquiries, strategic partnerships, media, institutional
        collaborations, and selected project conversations. It's not a general support inbox.
      </p>
    </div>
  </section>

  <section class="section contact-section">
    <div class="wrap contact-grid">
      <form
        id="contact-form"
        class="contact-form"
        novalidate
        data-contact-endpoint={contactEndpoint}
        onsubmit={contactEndpoint ? undefined : "return false;"}
      >
        <div class="form-field">
          <label for="field-name">Name <span aria-hidden="true">*</span></label>
          <input
            type="text"
            id="field-name"
            name="name"
            autocomplete="name"
            required
            aria-describedby="error-name"
          />
          <p class="form-error" id="error-name" role="alert" hidden></p>
        </div>

        <div class="form-field">
          <label for="field-organization">Organization</label>
          <input
            type="text"
            id="field-organization"
            name="organization"
            autocomplete="organization"
          />
        </div>

        <div class="form-field">
          <label for="field-email">Email <span aria-hidden="true">*</span></label>
          <input
            type="email"
            id="field-email"
            name="email"
            autocomplete="email"
            required
            aria-describedby="error-email"
          />
          <p class="form-error" id="error-email" role="alert" hidden></p>
        </div>

        <div class="form-field">
          <label for="field-website">Website (optional)</label>
          <input
            type="url"
            id="field-website"
            name="website"
            autocomplete="url"
            placeholder="https://"
            aria-describedby="error-website"
          />
          <p class="form-error" id="error-website" role="alert" hidden></p>
        </div>

        <div class="form-field">
          <label for="field-reason">Reason for inquiry <span aria-hidden="true">*</span></label>
          <select id="field-reason" name="reason" required aria-describedby="error-reason">
            <option value="">Select one</option>
            {reasonOptions.map((opt) => <option value={opt.value}>{opt.label}</option>)}
          </select>
          <p class="form-error" id="error-reason" role="alert" hidden></p>
        </div>

        <div class="form-field">
          <label for="field-constraint"
            >What is changing or constrained? <span aria-hidden="true">*</span></label
          >
          <textarea
            id="field-constraint"
            name="constraint"
            rows="3"
            required
            aria-describedby="error-constraint"></textarea>
          <p class="form-error" id="error-constraint" role="alert" hidden></p>
        </div>

        <div class="form-field">
          <label for="field-outcome">What outcome matters? <span aria-hidden="true">*</span></label>
          <textarea
            id="field-outcome"
            name="outcome"
            rows="3"
            required
            aria-describedby="error-outcome"></textarea>
          <p class="form-error" id="error-outcome" role="alert" hidden></p>
        </div>

        <div class="form-field">
          <label for="field-timeline">Timeline / urgency <span aria-hidden="true">*</span></label>
          <select id="field-timeline" name="timeline" required aria-describedby="error-timeline">
            {timelineOptions.map((opt) => <option value={opt.value}>{opt.label}</option>)}
          </select>
          <p class="form-error" id="error-timeline" role="alert" hidden></p>
        </div>

        <div class="form-field">
          <label for="field-budget">Budget range (optional)</label>
          <select id="field-budget" name="budget">
            {budgetOptions.map((opt) => <option value={opt.value}>{opt.label}</option>)}
          </select>
        </div>

        <div class="form-field">
          <label for="field-found">How did you find this site?</label>
          <input type="text" id="field-found" name="found" />
        </div>

        <!-- Honeypot: hidden from sighted and AT users, left open for bots. -->
        <div class="form-field form-field--honeypot" aria-hidden="true">
          <label for="field-hp">Leave this field blank</label>
          <input type="text" id="field-hp" name="hp_confirm" tabindex="-1" autocomplete="off" />
        </div>

        <p class="form-privacy">
          This form isn't connected to a delivery service yet — see the status note for details.
          Once it is, submissions will be for review only: no automated booking or scheduling, and
          no fixed response-time guarantee. See the
          <a href="/privacy" class="text-link">privacy page</a> for how data will be handled.
        </p>

        <button type="submit" class="btn btn--primary" id="contact-submit">Send inquiry</button>

        <div id="form-status" class="form-status" role="status" aria-live="polite" hidden></div>

        <details class="secondary-protocol">
          <summary>Secondary Protocol</summary>
          <div class="secondary-protocol-body">
            <p>
              A secondary intake channel — for encrypted routing, or for use if the primary form
              above is unavailable — is not yet provisioned. No PGP key, backup address, or secure
              drop link is published here yet; treat any message claiming to be one as
              unverified. Once a real secondary channel exists, its fingerprint and address will
              be published on this page, not sent separately.
            </p>
          </div>
        </details>
      </form>

      <aside class="contact-aside">
        <div class="card">
          <p class="label-mono">Status</p>
          <p>
            This form isn't connected to a delivery service yet, and there's no other verified
            direct contact route published here. Once a delivery destination is confirmed, this page
            will route to it — see docs/mark-2-release-audit.md for the exact blocker.
          </p>
        </div>
        <div class="card">
          <p class="label-mono">Scope</p>
          <p>
            Best for consulting engagements, strategic partnerships, media and press, institutional
            collaboration, and serious project conversations. Not the right channel for general
            customer support on HERO products.
          </p>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: var(--space-5);
    align-items: start;
  }

  @media (max-width: 56rem) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .form-field label {
    font-weight: 600;
    font-size: 0.92rem;
  }

  .form-field input,
  .form-field select,
  .form-field textarea {
    background: var(--color-bg-raised);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    padding: 0.75em 0.9em;
    min-height: 44px;
    color: var(--color-text);
  }

  .form-field textarea {
    min-height: 6rem;
    resize: vertical;
  }

  .form-field input:invalid[aria-invalid="true"],
  .form-field select[aria-invalid="true"],
  .form-field textarea[aria-invalid="true"] {
    border-color: var(--color-caution);
  }

  .form-error {
    color: var(--color-caution);
    font-size: 0.85rem;
  }

  .form-field--honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  .form-privacy {
    color: var(--color-text-faint);
    font-size: 0.85rem;
    max-width: var(--measure);
  }

  .form-status {
    border: var(--border-hairline);
    border-radius: var(--radius-md);
    padding: var(--space-2);
    font-size: 0.92rem;
  }

  .form-status[data-tone="pending-integration"] {
    border-color: var(--color-caution);
    background: var(--color-bg-raised);
  }

  .form-status[data-tone="error"] {
    border-color: var(--color-caution);
  }

  .contact-aside {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    position: sticky;
    top: 6rem;
  }

  .secondary-protocol {
    border: 1px solid var(--color-border-strong);
    padding: var(--space-2) var(--space-3);
  }

  .secondary-protocol summary {
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text);
  }

  .secondary-protocol-body {
    margin-top: var(--space-2);
    padding-top: var(--space-2);
    border-top: 1px solid var(--color-border);
  }

  .secondary-protocol-body p {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    line-height: 1.5;
  }
</style>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const statusEl = document.getElementById("form-status");

  // Mark 18: reads the build-time-resolved PUBLIC_CONTACT_ENDPOINT value off
  // the form's own data attribute (set in this file's frontmatter) rather
  // than importing it directly here, so this script keeps full TypeScript
  // processing (a `define:vars` script loses that — see
  // docs/mark-18-contact-intake-implementation.md). Empty string in every
  // build this repository runs today, which keeps this form exactly as
  // inert as it was before this pass — see docs/mark-2-launch-plan.md
  // "Contact-form decision" for the original rationale this still honors.
  const contactEndpoint = form?.dataset.contactEndpoint ?? "";

  const requiredFields = [
    { id: "field-name", errorId: "error-name", message: "Enter your name." },
    {
      id: "field-email",
      errorId: "error-email",
      message: "Enter a valid email address.",
      validate: (v: string) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v),
    },
    { id: "field-reason", errorId: "error-reason", message: "Choose a reason for your inquiry." },
    {
      id: "field-constraint",
      errorId: "error-constraint",
      message: "Tell us what's changing or constrained.",
    },
    { id: "field-outcome", errorId: "error-outcome", message: "Tell us what outcome matters." },
    { id: "field-timeline", errorId: "error-timeline", message: "Choose a timeline." },
  ];

  function showFieldError(id: string, errorId: string, message: string | null) {
    const input = document.getElementById(id) as
      HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement | null;
    const error = document.getElementById(errorId);
    if (!input || !error) return;
    if (message) {
      input.setAttribute("aria-invalid", "true");
      error.textContent = message;
      error.hidden = false;
    } else {
      input.removeAttribute("aria-invalid");
      error.hidden = true;
      error.textContent = "";
    }
  }

  function validateWebsite(): boolean {
    const website = document.getElementById("field-website") as HTMLInputElement | null;
    if (!website || !website.value) {
      showFieldError("field-website", "error-website", null);
      return true;
    }
    try {
      new URL(website.value);
      showFieldError("field-website", "error-website", null);
      return true;
    } catch {
      showFieldError("field-website", "error-website", "Enter a full URL, including https://.");
      return false;
    }
  }

  function validate(): boolean {
    let valid = true;
    for (const field of requiredFields) {
      const el = document.getElementById(field.id) as
        HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement | null;
      const value = el?.value.trim() ?? "";
      const passesCustom = field.validate ? field.validate(value) : value.length > 0;
      if (!passesCustom) {
        showFieldError(field.id, field.errorId, field.message);
        valid = false;
      } else {
        showFieldError(field.id, field.errorId, null);
      }
    }
    if (!validateWebsite()) valid = false;
    return valid;
  }

  function setStatus(message: string, tone: "success" | "error" | "pending-integration") {
    if (!statusEl) return;
    statusEl.hidden = false;
    statusEl.dataset.tone = tone;
    statusEl.textContent = message;
    statusEl.scrollIntoView({ behavior: "smooth", block: "nearest" });
  }

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (statusEl) statusEl.hidden = true;

    // Honeypot: if filled, silently treat as handled without submitting.
    const honeypot = document.getElementById("field-hp") as HTMLInputElement | null;
    if (honeypot?.value) {
      setStatus("Thanks — your inquiry has been received.", "success");
      form.reset();
      return;
    }

    if (!validate()) {
      const firstInvalid = form.querySelector('[aria-invalid="true"]') as HTMLElement | null;
      firstInvalid?.focus();
      setStatus("Please fix the highlighted fields and try again.", "error");
      return;
    }

    // No delivery backend is configured in this build (contactEndpoint is
    // an empty string in every build this repository runs today) — this is
    // the only outcome a valid submission can reach. Nothing is sent,
    // stored, or promised.
    if (!contactEndpoint) {
      setStatus(
        "This form isn't connected to a delivery service yet, so this inquiry can't be sent from this page right now. There's no other verified contact route published here yet either — please check back soon.",
        "pending-integration",
      );
      return;
    }

    const submitButton = document.getElementById("contact-submit") as HTMLButtonElement | null;
    if (submitButton) submitButton.disabled = true;
    setStatus("Sending…", "pending-integration");

    const name = (document.getElementById("field-name") as HTMLInputElement | null)?.value ?? "";
    const email = (document.getElementById("field-email") as HTMLInputElement | null)?.value ?? "";
    const organization =
      (document.getElementById("field-organization") as HTMLInputElement | null)?.value ?? "";
    const reason =
      (document.getElementById("field-reason") as HTMLSelectElement | null)?.value ?? "";
    const constraint =
      (document.getElementById("field-constraint") as HTMLTextAreaElement | null)?.value ?? "";
    const outcome =
      (document.getElementById("field-outcome") as HTMLTextAreaElement | null)?.value ?? "";
    const message = [
      reason && `Reason: ${reason}`,
      constraint && `What's changing/constrained: ${constraint}`,
      outcome && `Outcome that matters: ${outcome}`,
    ]
      .filter(Boolean)
      .join("\n\n");

    try {
      const response = await fetch(contactEndpoint, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ name, email, organization, message }),
      });
      const result = await response.json().catch(() => ({}) as { ok?: boolean; error?: string });
      if (response.ok && result.ok) {
        setStatus("Thanks — your inquiry has been received.", "success");
        form.reset();
      } else {
        setStatus(result.error ?? "Something went wrong. Please try again.", "error");
      }
    } catch {
      setStatus("Something went wrong. Please try again.", "error");
    } finally {
      if (submitButton) submitButton.disabled = false;
    }
  });
</script>
