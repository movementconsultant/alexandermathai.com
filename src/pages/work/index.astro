---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SystemBriefCard from "../../components/work/SystemBriefCard.astro";
import WorkFilter from "../../components/work/WorkFilter.astro";
import Button from "../../components/ui/Button.astro";

const entries = (await getCollection("work", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://alexandermathai.com/" },
    { "@type": "ListItem", position: 2, name: "Work", item: "https://alexandermathai.com/work" },
  ],
};
---

<BaseLayout
  title="Work — Alexander Mathai"
  description="Systems built where performance, culture, and operations meet: selected builds, systems, launches, and engagements across the Texas Movement International ecosystem."
  structuredData={[breadcrumbLd]}
>
  <section class="section section--tight">
    <div class="wrap">
      <p class="eyebrow">Work</p>
      <h1>Systems built where performance, culture, and operations meet.</h1>
      <p class="lede">
        This is a structured record of what's been built and why — not a visual-only portfolio. Each
        entry is a system brief: the constraint, the architecture, and what changed.
      </p>
      <WorkFilter />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <ul class="work-grid">
        {
          entries.map((entry) => (
            <li>
              <SystemBriefCard entry={entry} />
            </li>
          ))
        }
      </ul>
      <p id="work-empty-state" hidden class="work-empty-state">
        No system briefs in this category yet.
      </p>
    </div>
  </section>

  <section class="section" id="method">
    <div class="wrap">
      <h2>Method / engagement model</h2>
      <ol class="method-list">
        <li><strong>Diagnose.</strong> Identify the actual constraint, not the assumed one.</li>
        <li>
          <strong>Design.</strong> Scope the smallest system that resolves it — no more, no less.
        </li>
        <li>
          <strong>Build.</strong> Ship owned infrastructure instead of another rented dependency.
        </li>
        <li>
          <strong>Document.</strong> Leave decisions written down so the system can run without you in
          the room.
        </li>
        <li><strong>Measure.</strong> Track what actually changed, not just what shipped.</li>
      </ol>
    </div>
  </section>

  <section class="section section--tight" id="consulting">
    <div class="wrap consulting-cta">
      <div>
        <h2>Have a system that needs building?</h2>
        <p class="lede">
          Consulting engagements are the most direct way to work through this process together.
        </p>
      </div>
      <Button href="/contact" variant="primary">Discuss a system</Button>
    </div>
  </section>
</BaseLayout>

<style>
  .work-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: var(--space-3);
  }

  .work-empty-state {
    color: var(--color-text-muted);
    padding-block: var(--space-4);
  }

  .method-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    counter-reset: method;
    max-width: var(--measure);
  }

  .method-list li {
    padding-inline-start: 2.2rem;
    position: relative;
  }

  .method-list li::before {
    counter-increment: method;
    content: counter(method);
    position: absolute;
    left: 0;
    top: 0;
    font-family: var(--font-mono);
    color: var(--color-text-muted);
  }

  .consulting-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>
