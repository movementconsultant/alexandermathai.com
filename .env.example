# Copy to .env for local builds.
#
# PUBLIC_PREVIEW=true  -> every page gets <meta name="robots" content="noindex, nofollow">,
#                          robots.txt disallows all crawling, and no page is treated as indexable.
#                          Use this for ALL preview/staging builds, including this one.
# PUBLIC_PREVIEW=false -> production behavior: indexable, full robots.txt allow + sitemap
#                          reference. Only flip this for the actual production deploy, and only
#                          once the items in docs/mark-2-release-audit.md are resolved or
#                          explicitly accepted by the site owner.
PUBLIC_PREVIEW=true

# The /contact form has no submission endpoint of any kind and cannot send, collect, or store
# data — this is intentional, not a missing env var. There is no owner-approved, verified
# delivery backend yet. Connecting one requires an actual code change to src/pages/contact.astro
# (not just an environment variable), by design — see docs/mark-2-launch-plan.md
# "Contact-form decision".
