# Copy to .env for local development. Never commit a real .env file.

# Preview / noindex convention.
# Any value other than the literal string "false" is treated as preview mode:
# the site ships <meta name="robots" content="noindex, nofollow">, an empty
# sitemap, and no canonical link to the live production domain.
# This defaults to preview mode when unset — see docs/LAUNCH_BLOCKERS.md for
# what has to happen before this can safely be set to "false".
PUBLIC_PREVIEW=true
