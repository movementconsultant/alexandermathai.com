{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "src/**/*", "tests/**/*", "scripts/**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "strictNullChecks": true
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "workers"],
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  }
}
